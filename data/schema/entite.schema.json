{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entité administrative (département, commune ou arrondissement)",
  "type": "object",
  "required": [
    "id",
    "type",
    "nom",
    "tri",
    "parent",
    "source",
    "releveLe",
    "confiance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "departement",
        "commune",
        "arrondissement"
      ]
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "tri": {
      "type": "string",
      "pattern": "^[a-z0-9' -]+$",
      "description": "Clé de tri : nom sans accents, en minuscules, sans article initial 'Les', tirets conservés (ils trient avant les lettres)."
    },
    "parent": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "alias": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source": {
      "type": "string",
      "description": "Identifiant présent dans data/sources.json (vérifié par les tests)."
    },
    "releveLe": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "confiance": {
      "enum": [
        "officielle",
        "derivee",
        "provisoire"
      ]
    },
    "provisoire": {
      "type": "boolean"
    },
    "libelleLoi": {
      "type": "string",
      "minLength": 1,
      "description": "Libellé tel qu'imprimé dans la loi (majuscules sans accents), pour les arrondissements."
    },
    "graphie": {
      "enum": [
        "attestee",
        "deduite-du-libelle"
      ],
      "description": "attestee : écrit ainsi par la loi (arrondissement numéroté) ou attesté par un village homonyme du même arrondissement. deduite-du-libelle : majuscules de la loi remises en casse de titre, accents non vérifiables."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "departement"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^BJ-[A-Z]{2}$"
          },
          "parent": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "commune"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^BJ-[A-Z]{2}-[A-Z]{2,4}$"
          },
          "parent": {
            "type": "string",
            "pattern": "^BJ-[A-Z]{2}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "arrondissement"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^BJ-[A-Z]{2}-[A-Z]{2,4}-[0-9]{2}$"
          },
          "parent": {
            "type": "string",
            "pattern": "^BJ-[A-Z]{2}-[A-Z]{2,4}$"
          }
        }
      }
    }
  ]
}
