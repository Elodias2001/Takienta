{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calque des pôles de développement (versionné et daté séparément des autres niveaux)",
  "type": "object",
  "required": ["schemaVersion", "calque", "effectifAu", "provisoire", "poles"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "calque": { "const": "poles" },
    "effectifAu": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "provisoire": { "type": "boolean" },
    "poles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nom", "chefLieu", "communes", "source", "confiance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^PO-[A-Z]{2,3}$" },
          "nom": { "type": "string", "minLength": 1 },
          "chefLieu": { "oneOf": [{ "type": "string", "pattern": "^BJ-[A-Z]{2}-[A-Z]{2,4}$" }, { "type": "null" }], "description": "Null pour le Grand-Nokoué, qui n'a pas de chef-lieu." },
          "communes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^BJ-[A-Z]{2}-[A-Z]{2,4}$" }, "description": "Chef-lieu en tête quand il existe, puis ordre du champ tri." },
          "source": { "type": "string" },
          "confiance": { "enum": ["officielle", "derivee", "provisoire"] }
        }
      }
    }
  }
}
