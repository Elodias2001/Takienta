{
  "name": "benin-geo",
  "version": "0.1.0",
  "description": "La structure administrative du Bénin, avec la source de chaque enregistrement. Hors ligne, sans dépendance.",
  "license": "MIT",
  "author": "Elodias ADIMOU <olouwagnon@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elodias2001/Takienta.git",
    "directory": "packages/js"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./departements": {
      "import": {
        "types": "./dist/departements.d.ts",
        "default": "./dist/departements.js"
      },
      "require": {
        "types": "./dist/departements.d.cts",
        "default": "./dist/departements.cjs"
      }
    },
    "./communes": {
      "import": {
        "types": "./dist/communes.d.ts",
        "default": "./dist/communes.js"
      },
      "require": {
        "types": "./dist/communes.d.cts",
        "default": "./dist/communes.cjs"
      }
    },
    "./arrondissements": {
      "import": {
        "types": "./dist/arrondissements.d.ts",
        "default": "./dist/arrondissements.js"
      },
      "require": {
        "types": "./dist/arrondissements.d.cts",
        "default": "./dist/arrondissements.cjs"
      }
    },
    "./poles": {
      "import": {
        "types": "./dist/poles.d.ts",
        "default": "./dist/poles.js"
      },
      "require": {
        "types": "./dist/poles.d.cts",
        "default": "./dist/poles.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "data": "node ../../scripts/build-data.mjs",
    "build": "node ../../scripts/build-data.mjs && tsup",
    "type-check": "node ../../scripts/build-data.mjs && tsc --noEmit",
    "test": "pnpm build && vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "benin",
    "bénin",
    "communes",
    "departements",
    "arrondissements",
    "administratif",
    "geographie",
    "offline"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://takienta.sabar.app",
  "bugs": {
    "url": "https://github.com/Elodias2001/Takienta/issues"
  }
}
